            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "-sum by (instance) (rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|cni.*|flannel.*|cali.*\", instance=~\"$instance\"}[5m]))",
